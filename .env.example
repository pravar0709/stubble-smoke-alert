# NASA FIRMS MAP_KEY — get free at https://firms.modaps.eosdis.nasa.gov/api/
# Leave blank to use weather-only model (no fire data)
FIRMS_MAP_KEY=

# S3 bucket name for deployment (created by SAM template)
S3_BUCKET_NAME=stubble-smoke-alert-bucket

# AWS Region
AWS_REGION=ap-south-1

# API Gateway URL (filled after deployment)
API_BASE_URL=
